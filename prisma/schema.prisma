generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationLevel {
  LISTED // Level 1 — basic directory profile
  VERIFIED // Level 2 — Collective has reviewed submitted professional info
  MEMBER // Level 3 — verified + active paid Collective membership
  FEATURED // Level 4 — member who meets criteria for enhanced visibility
}

enum MembershipTier {
  NONE
  FOUNDING // Founding member (free for 1 year) — 50 slots
  PROVIDER // Collective Provider — $29/mo or $290/yr
  PROFESSIONAL // Collective Professional — $59/mo or $590/yr
}

enum SubmissionStatus {
  PENDING // Awaiting admin review
  APPROVED // Approved for publication
  REJECTED // Rejected by admin
}

enum ForumRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum Format {
  IN_PERSON
  VIRTUAL
  BOTH
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventAccess {
  OPEN // open to all
  MEMBER // Collective members only
  TICKETED // paid, members save
}

model Practitioner {
  id            String   @id @default(cuid())
  slug          String   @unique
  published     Boolean  @default(false)

  name          String
  pronouns      String?
  primaryModality String
  modalities    String[] @default([])
  specialties   String[] @default([])
  town          String
  region        String?
  format        Format   @default(IN_PERSON)

  bio           String   @db.Text
  credentials   String[] @default([])
  yearsPracticing Int?
  languages     String[] @default([])

  rateLabel     String?  // e.g. "$120 / session · sliding scale"
  priceRange    String?  // "$", "$$", "$$$" — used for filtering

  photoUrl      String?
  website       String?
  instagram     String?
  bookingUrl    String?
  contactEmail  String?
  contactPhone  String?

  verificationLevel VerificationLevel @default(LISTED)
  membershipTier    MembershipTier    @default(NONE)
  membershipPeriod  BillingPeriod?
  membershipActive  Boolean           @default(false)
  membershipExpiresAt DateTime?       // For founding members: 1 year from creation
  accepting         Boolean           @default(true)
  featuredUntil     DateTime?

  // Authentication
  email         String   @unique
  passwordHash  String?  // bcrypt hash
  lastLoginAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applicationId String?  @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  // Relations
  marketingSubmissions MarketingSubmission[]
  blogPosts            BlogPost[]
  forumPosts           ForumPost[]
  profileViews         ProfileView[]

  @@index([email])
}

model Application {
  id            String   @id @default(cuid())
  status        ApplicationStatus @default(PENDING)

  name          String
  email         String
  phone         String?
  primaryModality String
  modalities    String[] @default([])
  town          String
  format        Format   @default(IN_PERSON)

  yearsPracticing Int?
  credentials   String   @db.Text // free text — trainings/certifications/licenses
  insurance     Boolean  @default(false)
  businessInfo  String?  @db.Text
  website       String?
  instagram     String?

  bio           String   @db.Text
  message       String?  @db.Text
  agreedToCodeOfConduct Boolean @default(false)

  reviewedAt    DateTime?
  reviewNotes   String?  @db.Text

  createdAt     DateTime @default(now())

  practitioner  Practitioner?
}

model Event {
  id            String   @id @default(cuid())
  slug          String   @unique
  published     Boolean  @default(true)

  title         String
  description   String   @db.Text
  modality      String?
  host          String?

  startsAt      DateTime
  endsAt        DateTime?
  location      String
  locationType  Format   @default(IN_PERSON)
  town          String?

  access        EventAccess @default(OPEN)
  price         String?
  capacity      Int?

  isFlagship    Boolean  @default(false) // Wellness Weekend
  imageUrl      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rsvps         EventRSVP[]
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  notes     String?
  createdAt DateTime @default(now())

  @@index([eventId])
}

model Resource {
  id          String   @id @default(cuid())
  slug        String   @unique
  published   Boolean  @default(false)

  title       String
  category    String   // e.g. "Guide", "Article", "Education"
  excerpt     String   @db.Text
  content     String   @db.Text // markdown
  coverImageUrl String?
  author      String?

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // e.g. "homepage", "wellness-weekend"
  createdAt DateTime @default(now())
}

model MarketingSubmission {
  id              String   @id @default(cuid())
  practitionerId  String
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  title           String
  content         String   @db.Text
  imageUrl        String?
  status          SubmissionStatus @default(PENDING)
  submittedFor    String   // "newsletter", "blog", "event"

  reviewedAt      DateTime?
  reviewNotes     String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([practitionerId])
  @@index([status])
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique

  title           String
  excerpt         String   @db.Text
  content         String   @db.Text // markdown
  coverImageUrl   String?

  authorId        String
  author          Practitioner @relation(fields: [authorId], references: [id], onDelete: Cascade)

  status          SubmissionStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  isMonthlySpotlight Boolean @default(false) // Monthly "new member" feature

  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
}

model ProfileView {
  id              String   @id @default(cuid())
  practitionerId  String
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  referrer        String?  // "search", "directory", "event", "blog", "external"
  viewedAt        DateTime @default(now())

  @@index([practitionerId])
  @@index([viewedAt])
}

model ForumTopic {
  id              String   @id @default(cuid())
  slug            String   @unique

  title           String
  description     String?  @db.Text
  published       Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts           ForumPost[]
}

model ForumPost {
  id              String   @id @default(cuid())
  topicId         String
  topic           ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  authorId        String?
  author          Practitioner? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  title           String?  // Only for top-level posts
  content         String   @db.Text

  parentPostId    String?
  parentPost      ForumPost? @relation("PostReplies", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies         ForumPost[] @relation("PostReplies")

  published       Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([topicId])
  @@index([authorId])
  @@index([parentPostId])
}

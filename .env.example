# ── Database ─────────────────────────────────────────────────────────────
# Any Postgres connection string works. Easiest path on Vercel: Storage tab
# → Create Database → Postgres (Neon), which sets this automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://wellnesscollectiveak.com"

# ── Admin dashboard (single operator login, no user table) ────────────────
# Generate SESSION_SECRET with: openssl rand -base64 32
# Generate ADMIN_PASSWORD_HASH with: npx tsx -e "import bcrypt from 'bcryptjs'; bcrypt.hash(process.argv[1], 10).then(console.log)" "your-password-here"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""

# ── Square (membership billing) ────────────────────────────────────────────
# Leave unset to launch without live payments — "Join" buttons fall back to
# the Apply form automatically until these are set.
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_ENVIRONMENT="sandbox"
# Subscription Plan Variation IDs from Square Dashboard → Items & Orders → Subscriptions
SQUARE_PLAN_PROVIDER_MONTHLY=""
SQUARE_PLAN_PROVIDER_ANNUAL=""
SQUARE_PLAN_PROFESSIONAL_MONTHLY=""
SQUARE_PLAN_PROFESSIONAL_ANNUAL=""
SQUARE_PLAN_FOUNDING_ANNUAL=""
